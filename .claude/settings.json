{
  "permissions": {
    "deny": [
      "Bash(npm run deploy)",
      "Bash(npm run deploy:prod)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npm run db:migrate:remote)",
      "Bash(npm run db:create:remote)",
      "Bash(wrangler d1 * --remote*)",
      "Bash(npx wrangler d1 * --remote*)",
      "Read(./.dev.vars)",
      "Read(./.env)",
      "Read(./.env.local)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)"
    ],
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run dev)",
      "Bash(npm run db:migrate:local)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue *)",
      "Bash(gh pr create*)",
      "WebSearch",
      "WebFetch(domain:hono.dev)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-stop.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}

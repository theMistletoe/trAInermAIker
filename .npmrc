# wrangler 4.114+ declares a peerOptional dependency on @cloudflare/workers-types@^5
# while this template pins ^4 (the version its 5-tsconfig setup was verified
# against). npm ci re-validates peer ranges even from a healthy lockfile, so
# without this flag every `npm ci` (local and CI) fails with ERESOLVE. The
# conflict is types-only (peerOptional) — resolution is safe.
legacy-peer-deps=true

{
  "name": "cloudflare-templete",
  "version": "0.1.0",
  "description": "AI-driven development template on Cloudflare Workers + D1 + React + Hono",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:prod": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cloudflare_templete --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloudflare_templete --remote",
    "db:create:remote": "wrangler d1 create cloudflare_templete",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:evidence": "E2E_EVIDENCE=1 playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:clean": "rm -rf playwright-report test-results",
    "gen:types": "wrangler types",
    "typecheck": "npm run gen:types && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.client.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@cloudflare/vite-plugin": "^1.18.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^4.20260507.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.4",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.10.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  }
}

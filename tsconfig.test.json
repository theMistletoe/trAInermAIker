{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@server/*": ["./src/server/*"]
    }
  },
  "include": [
    "worker-configuration.d.ts",
    "tests/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/client/**", "tests/helpers/**", "tests/e2e/**"]
}
